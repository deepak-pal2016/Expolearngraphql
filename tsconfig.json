{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@screens/*": ["src/screens/*"],
      "@redux/*": ["src/redux/*"],
      "@routes/*": ["src/routes/*"],
      "@assets/*": ["src/assets/*"],
      "@utils/*": ["src/utils/*"],
      "@constant/*": ["src/constant/*"],
      "@helpers/*": ["src/helpers/*"],
      "@services/*":["src/services"],
      "@navigation/*":["src/navigation"],
      "@styles/*":["src/styles"],
      "@graphqls/*":["src/graphqls"],
      "@zustand/*":["src/zustand"]
    }
  }
}
