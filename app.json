{
  "expo": {
    "name": "Expoappgraphql",
    "slug": "Expoappgraphql",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/images/appicons.png",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.expoappgraphql",
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },

    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-notifications"
    ]
  }
}
